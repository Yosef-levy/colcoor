{
  "name": "colcoor",
  "private": true,
  "workspaces": ["packages/extension"],
  "scripts": {
    "build": "npm run build -w colcoor-extension",
    "lint": "npm run lint -w colcoor-extension",
    "test": "npm run test:extension && npm run test:backend",
    "test:extension": "npm run test -w colcoor-extension",
    "test:backend": "sh -c 'cd packages/backend && if [ -x .venv/bin/python ]; then .venv/bin/python -m pytest -q; else python3 -m pytest -q; fi'",
    "package:extension": "bash scripts/package-extension-to-enterprise-dist.sh",
    "ship:artifacts": "bash scripts/ship-artifacts.sh",
    "bundle:enterprise": "bash scripts/build-enterprise-bundle.sh",
    "bundle:enterprise:skip-vsix": "bash scripts/build-enterprise-bundle.sh --skip-vsix",
    "bundle:self-host-release": "bash scripts/build-self-host-bundle.sh",
    "bundle:release": "bash scripts/build-self-host-bundle.sh",
    "checksums:release": "bash scripts/generate-release-checksums.sh",
    "compose:self-host": "docker compose -f docker-compose.self-host.yml up -d --build"
  }
}
