# Local development (packages/backend). For Docker production use repo root `.env.example`.

COLCOOR_ENV=development
PORT=8000
CORS_ORIGINS=

# Optional until DB layer is wired:
# DATABASE_URL=postgresql+asyncpg://colcoor:colcoor@127.0.0.1:5432/colcoor
# JWT_SECRET=dev-only-not-for-production

# Optional: COLCOOR_MAX_IMAGE_BYTES=8388608
# Optional: GCS for images (production). Without GCS_BUCKET, images use local disk:
# COLCOOR_LOCAL_IMAGE_STORAGE_PATH=/tmp/colcoor-images
# GCS_BUCKET=your-bucket

# Optional: Redis pub/sub for low-latency side-chat SSE (docker-compose.yml exposes 6379).
# REDIS_URL=redis://127.0.0.1:6379/0

# Optional: hard-delete soft-deleted main-thread events after retention (Postgres only).
# COLCOOR_EVENT_PURGE_SCHEDULER_ENABLED=false
# COLCOOR_EVENT_PURGE_INTERVAL_SECONDS=86400
# COLCOOR_EVENT_PURGE_INITIAL_DELAY_SECONDS=300
# COLCOOR_EVENT_SOFT_DELETE_RETENTION_HOURS=336
# COLCOOR_EVENT_DELETE_UNDO_WINDOW_MINUTES=5
