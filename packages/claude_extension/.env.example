# Colcoor Claude Desktop Extension — local development env.
# Copy to `.env` (gitignored) and source it when running the MCP server locally:
#   set -a; source .env; set +a; node dist/server.js

# Base URL of the Colcoor backend HTTP API (no trailing slash, no path).
# Examples:
#   http://127.0.0.1:8000  -> local uvicorn (packages/backend)
#   http://127.0.0.1       -> local docker-compose.prod nginx
#   https://colcoor.example.com -> production
COLCOOR_BACKEND_URL=http://127.0.0.1:8000

# Colcoor API JWT (Bearer access_token returned by POST /api/v1/auth/cursor).
# TODO: obtain by signing in once via the Cursor extension and copying the SecretStorage
# value, or via the colcoor_sign_in_with_cursor tool which exchanges a Cursor IdP token.
COLCOOR_API_TOKEN=

# Optional fallback: an IdP access token (GitHub/Microsoft/Google) acquired in Cursor.
# When set and COLCOOR_API_TOKEN is empty, the MCP server will exchange it against
# POST /api/v1/auth/cursor on startup (see authentication.md).
COLCOOR_CURSOR_ACCESS_TOKEN=
COLCOOR_PROVIDER_HINT=auto

# Optional: override the request timeout (ms) for backend calls. Default: 30000.
# COLCOOR_REQUEST_TIMEOUT_MS=30000

# Optional: stable label used as `author` when the MCP server appends events.
# Defaults to "claude_desktop".
# COLCOOR_AGENT_AUTHOR=claude_desktop
