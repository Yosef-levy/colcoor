{
  "name": "colcoor-extension",
  "displayName": "Colcoor",
  "description": "Colcoor conversation orchestrator for Cursor (see repo docs/).",
  "version": "0.0.1",
  "publisher": "colcoor",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "colcoor.setupCursorCli",
        "title": "Colcoor: Set up Cursor CLI (agent)"
      },
      {
        "command": "colcoor.signIn",
        "title": "Colcoor: Sign in"
      },
      {
        "command": "colcoor.signInDev",
        "title": "Colcoor: Sign in (dev)"
      },
      {
        "command": "colcoor.signOut",
        "title": "Colcoor: Sign out"
      },
      {
        "command": "colcoor.newConversation",
        "title": "Colcoor: New conversation",
        "icon": "$(add)"
      },
      {
        "command": "colcoor.refreshConversations",
        "title": "Colcoor: Refresh conversations",
        "icon": "$(refresh)"
      },
      {
        "command": "colcoor.sendMessage",
        "title": "Colcoor: Send message"
      },
      {
        "command": "colcoor.copyConversationId",
        "title": "Colcoor: Copy conversation ID"
      },
      {
        "command": "colcoor.openAbout",
        "title": "Colcoor: About"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "colcoor",
          "title": "Colcoor",
          "icon": "media/colcoor-activity.svg"
        }
      ]
    },
    "views": {
      "colcoor": [
        {
          "id": "colcoor.conversations",
          "name": "Conversations"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "colcoor.conversations",
        "contents": "Sign in with the same account you use in Cursor, then create a thread.\n[Sign in](command:colcoor.signIn)\n[Sign in (dev only)](command:colcoor.signInDev)\n[New conversation](command:colcoor.newConversation)\n[Refresh](command:colcoor.refreshConversations)\n[Cursor CLI (`agent`) setup](command:colcoor.setupCursorCli)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "colcoor.newConversation",
          "when": "view == colcoor.conversations",
          "group": "navigation@1"
        },
        {
          "command": "colcoor.refreshConversations",
          "when": "view == colcoor.conversations",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "colcoor.sendMessage",
          "when": "view == colcoor.conversations && viewItem == conversation",
          "group": "1_colcoor@0"
        },
        {
          "command": "colcoor.copyConversationId",
          "when": "view == colcoor.conversations && viewItem == conversation",
          "group": "1_colcoor@1"
        }
      ]
    },
    "configuration": {
      "title": "Colcoor",
      "properties": {
        "colcoor.backendBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "API origin only (no path, no trailing slash). Remote VM: https://your-host. Local docker-compose.prod: http://127.0.0.1 (nginx :80). Local uvicorn: http://127.0.0.1:8000."
        },
        "colcoor.agentMode": {
          "type": "string",
          "enum": ["auto", "headless", "stub"],
          "default": "auto",
          "description": "How to run the main-thread assistant after your message is saved. auto: try Cursor CLI `agent -p` when on PATH, otherwise stub. headless: always run CLI (fails loudly if missing or errors). stub: placeholder reply only."
        },
        "colcoor.agentExecutable": {
          "type": "string",
          "default": "agent",
          "description": "Executable for Cursor headless agent (see https://cursor.com/docs/cli/headless). Must be on PATH or an absolute path."
        },
        "colcoor.agentTimeoutMs": {
          "type": "number",
          "default": 300000,
          "minimum": 10000,
          "maximum": 3600000,
          "description": "Max time in milliseconds to wait for one `agent -p` run (default 5 minutes)."
        },
        "colcoor.promptForCursorCliOnActivate": {
          "type": "boolean",
          "default": true,
          "description": "If the Cursor CLI (`agent`) is not on PATH, show a setup hint a few seconds after load (only when agent mode is not stub). Colcoor cannot bundle the CLI; use Colcoor: Set up Cursor CLI or the official installer."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "test": "vitest run",
    "package": "npm run build && vsce package --no-dependencies",
    "open-in-cursor": "npm run build && cursor --extensionDevelopmentPath=\"$PWD\""
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.5"
  }
}
