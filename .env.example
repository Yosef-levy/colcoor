# =============================================================================
# Colcoor extension backend — production / Docker Compose (see docker-compose.prod.yml)
# =============================================================================
# Copy to `.env` at the repo root and replace placeholder values before:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# This API is Python (FastAPI). NODE_ENV is set to production in compose for
# ecosystem tooling; the app reads COLCOOR_* / variables below.

# --- Runtime ---
NODE_ENV=production
COLCOOR_ENV=production

# Internal API port: docker-compose.prod.yml pins the backend to 8000 to match nginx upstream.
# Change only if you also edit nginx/nginx.conf and the backend service environment there.
PORT=8000

# Gunicorn workers (UvicornWorker). Default 2 is intentionally conservative for a small VM
# (1–2 vCPU, limited RAM). Raising workers increases memory and context switching; typical
# upper bound for this stack is ~8 unless you profile and size the VM accordingly.
# Rule of thumb for I/O-bound APIs: (2 × vCPU) + 1, capped around 8 — still override via env.
WEB_CONCURRENCY=2

# Python logging level for the API (stdout): DEBUG | INFO | WARNING | ERROR
COLCOOR_LOG_LEVEL=INFO

# Public site / API browser origin(s), comma-separated (CORS).
# - Empty: CORS middleware is NOT installed → browsers cannot use wildcard cross-origin;
#   non-browser clients (e.g. Cursor extension HTTP) are unaffected.
# - Non-empty: only listed origins are allowed (never '*'). Example:
# CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=

# Optional: used in docs / future redirects (not required for nginx `server_name _`).
DOMAIN=

# --- Postgres (Docker service hostname: postgres) ---
POSTGRES_DB=colcoor
POSTGRES_USER=colcoor
# REQUIRED: use a long random secret in production.
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32

# SQLAlchemy / async URL (must match POSTGRES_* above). Hostname `postgres` is the compose service name.
# Example (asyncpg driver, matches optional backend `[db]` extra):
DATABASE_URL=postgresql+asyncpg://colcoor:change-me-use-openssl-rand-hex-32@postgres:5432/colcoor

# --- Auth (issue/verify backend JWTs) ---
# REQUIRED in production: long random secret (see startup validation in colcoor_backend.core.validation).
JWT_SECRET=change-me-use-openssl-rand-hex-48

# Optional: IdP probe order when POST /auth/cursor receives provider_hint=auto (extension usually sends explicit hint).
# CURSOR_AUTH_PROVIDER_ORDER=github,microsoft,google
# Optional: upstream HTTP timeout in seconds for GitHub / Microsoft / Google profile calls (default 12).
# CURSOR_AUTH_HTTP_TIMEOUT_SECONDS=12
