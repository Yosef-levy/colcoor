# =============================================================================
# Colcoor extension backend — production / Docker Compose (see docker-compose.prod.yml)
# =============================================================================
# Copy to `.env` at the repo root and replace placeholder values before:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# This API is Python (FastAPI). NODE_ENV is set to production in compose for
# ecosystem tooling; the app reads COLCOOR_* / variables below.

# --- Runtime ---
NODE_ENV=production
COLCOOR_ENV=production

# Internal API port: docker-compose.prod.yml pins the backend to 8000 to match nginx upstream.
# Change only if you also edit nginx/nginx.conf and the backend service environment there.
PORT=8000

# Gunicorn workers (UvicornWorker). Default 2 is intentionally conservative for a small VM
# (1–2 vCPU, limited RAM). Raising workers increases memory and context switching; typical
# upper bound for this stack is ~8 unless you profile and size the VM accordingly.
# Rule of thumb for I/O-bound APIs: (2 × vCPU) + 1, capped around 8 — still override via env.
WEB_CONCURRENCY=2

# Python logging level for the API (stdout): DEBUG | INFO | WARNING | ERROR
COLCOOR_LOG_LEVEL=INFO
# Log format: json | text (default json when COLCOOR_ENV=production)
# COLCOOR_LOG_FORMAT=json
# Prometheus /metrics endpoint (default true)
# COLCOOR_METRICS_ENABLED=true

# Per-user rate limiting (JWT sub); anonymous traffic falls back to client IP.
# /health and /ready are never limited. Use Redis-backed store when running multiple replicas.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_RPS_PER_USER=10
# RATE_LIMIT_BURST_PER_USER=20
# RATE_LIMIT_RPS_ANON=5
# RATE_LIMIT_BURST_ANON=10
# Honor X-Forwarded-For for anonymous IP buckets (set true behind nginx in production)
# RATE_LIMIT_TRUST_PROXY=true

# Backups (see docs/backup-and-restore.md; scripts/backup-postgres.sh)
# COLCOOR_BACKUP_DIR=./backups
# COLCOOR_BACKUP_RETENTION_DAYS=14
# COLCOOR_BACKUP_OFFSITE=backup@host:/var/backups/colcoor/

# Optional monitoring profile (docker compose --profile monitoring):
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me
# GRAFANA_ROOT_URL=http://localhost:3000

# Public site / API browser origin(s), comma-separated (CORS).
# - Empty: CORS middleware is NOT installed → browsers cannot use wildcard cross-origin;
#   non-browser clients (e.g. Cursor extension HTTP) are unaffected.
# - Non-empty: only listed origins are allowed (never '*'). Example:
# CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=

# Optional: used in docs / future redirects (not required for nginx `server_name _`).
DOMAIN=

# --- Postgres (Docker service hostname: postgres) ---
POSTGRES_DB=colcoor
POSTGRES_USER=colcoor
# REQUIRED: use a long random secret in production.
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32

# Application DB URL (via PgBouncer in production). Hostname `pgbouncer`, port 6432.
DATABASE_URL=postgresql+asyncpg://colcoor:change-me-use-openssl-rand-hex-32@pgbouncer:6432/colcoor

# Alembic / DDL: direct Postgres (bypass transaction pooling). Sync psycopg driver.
DATABASE_MIGRATION_URL=postgresql+psycopg://colcoor:change-me-use-openssl-rand-hex-32@postgres:5432/colcoor

# SQLAlchemy pool per Gunicorn worker (see docs/pgbouncer.md for sizing).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# PgBouncer server pool (optional; defaults in pgbouncer/pgbouncer.ini).
# PGBOUNCER_MAX_CLIENT_CONN=200
# PGBOUNCER_DEFAULT_POOL_SIZE=20
# PGBOUNCER_RESERVE_POOL_SIZE=5

# --- Conversation images (GCS; required in production) ---
# COLCOOR_IMAGE_STORAGE=gcs
GCS_BUCKET=your-project-colcoor-images
# GCS_SIGNED_URL_TTL_SECONDS=300
# COLCOOR_MAX_IMAGE_BYTES=8388608
# Local dev without GCS: omit GCS_BUCKET (uses COLCOOR_LOCAL_IMAGE_STORAGE_PATH, default /tmp/colcoor-images)
# COLCOOR_LOCAL_IMAGE_STORAGE_PATH=/tmp/colcoor-images

# --- Redis (side-chat SSE wakeups; required in production) ---
# Compose service hostname: redis. Omit locally to use poll-only SSE (higher latency).
REDIS_URL=redis://redis:6379/0

# --- Auth (issue/verify backend JWTs) ---
# REQUIRED in production: long random secret (see startup validation in colcoor_backend.core.validation).
JWT_SECRET=change-me-use-openssl-rand-hex-48

# Optional: IdP probe order when POST /auth/cursor receives provider_hint=auto (extension usually sends explicit hint).
# CURSOR_AUTH_PROVIDER_ORDER=github,microsoft,google
# Optional: upstream HTTP timeout in seconds for GitHub / Microsoft / Google profile calls (default 12).
# CURSOR_AUTH_HTTP_TIMEOUT_SECONDS=12

# --- Soft-deleted main-thread events (see docs/domain-model.md §3.4) ---
# When true, each API worker schedules a background loop (use advisory lock so only one purges at a time).
# docker-compose.prod.yml defaults this to true for the backend service.
# COLCOOR_EVENT_PURGE_SCHEDULER_ENABLED=true
# COLCOOR_EVENT_PURGE_INTERVAL_SECONDS=86400
# COLCOOR_EVENT_PURGE_INITIAL_DELAY_SECONDS=300
# COLCOOR_EVENT_SOFT_DELETE_RETENTION_HOURS=336
# COLCOOR_EVENT_DELETE_UNDO_WINDOW_MINUTES=5
