# GCP provisioning config for Colcoor multi-VM (hosted profile).
# Copy to gcp.env, edit, then:
#   ./scripts/deploy-multi-vm.sh provision-gcp --config scripts/gcp/gcp.env --shared-env ./shared.env
#
# Requires: gcloud CLI, billing enabled, APIs enabled (script can enable them).

COLCOOR_GCP_PROJECT=your-gcp-project-id
COLCOOR_GCP_REGION=us-central1
COLCOOR_GCP_ZONE=us-central1-a
COLCOOR_GCP_NETWORK=default

# Resource names (created if missing)
COLCOOR_CLOUDSQL_INSTANCE=colcoor-prod
COLCOOR_REDIS_INSTANCE=colcoor-redis
COLCOOR_GCS_BUCKET=your-project-colcoor-images
COLCOOR_LB_NAME=colcoor-api-lb

# Cloud SQL
COLCOOR_CLOUDSQL_TIER=db-custom-2-7680
COLCOOR_CLOUDSQL_VERSION=POSTGRES_16
COLCOOR_POSTGRES_DB=colcoor
COLCOOR_POSTGRES_USER=colcoor
# COLCOOR_POSTGRES_PASSWORD=   # generated on first provision if empty

# API VMs for load balancer (comma-separated names in COLCOOR_GCP_ZONE)
COLCOOR_API_VM_INSTANCES=colcoor-api-1,colcoor-api-2
COLCOOR_API_VM_TAG=colcoor-api

# Pool sizing inputs (size-db-pools.sh)
COLCOOR_API_REPLICAS=2
WEB_CONCURRENCY=2
# CLOUDSQL_MAX_CONNECTIONS=100   # optional override after instance exists

# App service account for GCS (optional; default: first API VM's attached SA)
# COLCOOR_GCS_SERVICE_ACCOUNT=colcoor-api@project.iam.gserviceaccount.com

# Secrets (generated into shared.env if missing)
# JWT_SECRET=
